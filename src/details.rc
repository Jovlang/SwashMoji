#include <windows.h>
#define IDD_DETAILS 400
// Uses the editor rhythm: 12 outer margin, 6 related-control gap,
// 8 button gap, and 20 button height (all dialog units).
IDD_DETAILS DIALOGEX 0, 0, 360, 226
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Details - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    CONTROL "", 401, "STATIC", SS_OWNERDRAW, 12, 10, 336, 60
    LTEXT "", 402, 12, 74, 336, 32
    LTEXT "&Variant for the next insertion or copy", 404, 12, 110, 336, 12
    LISTBOX 403, 12, 126, 336, 40, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_MULTICOLUMN | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_HSCROLL | WS_TABSTOP
    LTEXT "Use once keeps your global skin tone unchanged.", 405, 12, 172, 336, 14
    DEFPUSHBUTTON "&Use once", IDOK, 176, 197, 82, 20
    PUSHBUTTON "&Cancel", IDCANCEL, 266, 197, 82, 20
END
