#include <windows.h>
#include "vocabulary_ids.h"

// Compact dialog-unit rhythm shared by these native editors:
// 12 outer margin, 12 section gap, 4 label-to-control gap,
// 6 related-control gap, 8 button gap, and 20-22 button height.
IDD_VOCABULARY DIALOGEX 0, 0, 552, 432
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_THICKFRAME | WS_MAXIMIZEBOX
CAPTION "My vocabulary - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Save phrases and emoji combinations for quick access.", IDC_VOCABULARY_INTRO, 16, 14, 520, 16
    LTEXT "Library", IDC_LIBRARY_HEADING, 28, 48, 176, 16
    LTEXT "Saved &aliases", IDC_ALIASES_HEADING, 28, 76, 176, 12
    LISTBOX IDC_ALIASES, 28, 94, 176, 112, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "+ &New", IDC_NEW_ALIAS, 28, 214, 62, 24
    PUSHBUTTON "&Delete", IDC_DELETE_ALIAS, 142, 214, 62, 24
    LTEXT "Pinned fa&vorites", IDC_PINS_HEADING, 28, 256, 176, 12
    LISTBOX IDC_PINS, 28, 274, 176, 66, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Up", IDC_PIN_UP, 28, 348, 28, 24
    PUSHBUTTON "D&own", IDC_PIN_DOWN, 62, 348, 28, 24
    PUSHBUTTON "Unp&in", IDC_UNPIN, 142, 348, 62, 24
    LTEXT "Alias editor", IDC_ALIAS_HEADING, 244, 48, 280, 16
    LTEXT "&Phrase", IDC_PHRASE_LABEL, 244, 76, 280, 12
    EDITTEXT IDC_PHRASE, 244, 94, 280, 24, ES_AUTOHSCROLL
    LTEXT "&Emoji", IDC_SEARCH_LABEL, 244, 130, 280, 12
    EDITTEXT IDC_TARGET_QUERY, 244, 148, 280, 24, ES_AUTOHSCROLL
    LTEXT "&Results", IDC_RESULTS_LABEL, 244, 184, 280, 12
    LISTBOX IDC_TARGET_RESULTS, 244, 202, 280, 66, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    LTEXT "Selected emoji", IDC_SELECTED_LABEL, 244, 280, 280, 12
    CONTROL "Choose an emoji above.", IDC_TARGET_PREVIEW, "STATIC", SS_OWNERDRAW, 244, 298, 280, 42
    DEFPUSHBUTTON "&Save alias", IDC_SAVE_ALIAS, 244, 348, 96, 24
    PUSHBUTTON "Pin &favorite", IDC_PIN_TARGET, 348, 348, 96, 24
    PUSHBUTTON "&Close", IDCANCEL, 448, 398, 88, 24
    PUSHBUTTON "+ &New combination / edit...", IDC_COMBINATIONS, 16, 398, 176, 24
    LTEXT "", IDC_VOCABULARY_STATUS, 244, 376, 280, 18
END
IDD_COMBINATIONS DIALOGEX 0, 0, 560, 452
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combinations - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "&Saved combinations", IDC_COMBO_SAVED_HEADING, 12, 10, 148, 12
    LTEXT "Select one to edit, or start new.", IDC_COMBO_SAVED_HINT, 12, 25, 148, 12
    LISTBOX IDC_COMBO_SAVED, 12, 42, 148, 320, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&New", IDC_COMBO_NEW, 12, 370, 70, 22
    PUSHBUTTON "&Delete", IDC_COMBO_DELETE, 90, 370, 70, 22
    CONTROL "", -1, "STATIC", SS_ETCHEDVERT, 170, 10, 1, 382
    LTEXT "1. Name / &trigger", IDC_COMBO_NAME_HEADING, 182, 10, 366, 12
    LTEXT "Choose a short phrase used to find this combination.", IDC_COMBO_NAME_HINT, 182, 25, 366, 12
    EDITTEXT IDC_COMBO_NAME, 182, 42, 366, 22, ES_AUTOHSCROLL
    LTEXT "2. Add emoji", IDC_COMBO_ADD_HEADING, 182, 76, 72, 12
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 260, 82, 288, 1
    LTEXT "Find an emoji, choose a variant, then Add.", IDC_COMBO_ADD_HINT, 182, 91, 366, 12
    LTEXT "Find &emoji", -1, 182, 108, 366, 12
    EDITTEXT IDC_COMBO_QUERY, 182, 122, 366, 22, ES_AUTOHSCROLL
    LTEXT "Res&ults", -1, 182, 151, 366, 12
    LISTBOX IDC_COMBO_RESULTS, 182, 165, 366, 64, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT "Var&iant", -1, 182, 240, 48, 12
    COMBOBOX IDC_COMBO_VARIANTS, 238, 236, 226, 120, CBS_DROPDOWNLIST | CBS_OWNERDRAWFIXED | CBS_HASSTRINGS | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Add", IDC_COMBO_ADD, 472, 235, 76, 22
    LTEXT "3. Se&quence (2-8 emoji, insertion order)", IDC_COMBO_SEQUENCE_HEADING, 182, 275, 210, 12
    CONTROL "", -1, "STATIC", SS_ETCHEDHORZ, 398, 281, 150, 1
    LTEXT "Select an item to remove or move it.", IDC_COMBO_SEQUENCE_HINT, 182, 290, 366, 12
    LISTBOX IDC_COMBO_ENTRIES, 182, 307, 366, 55, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Re&move", IDC_COMBO_REMOVE, 182, 370, 78, 22
    PUSHBUTTON "Move &left", IDC_COMBO_LEFT, 268, 370, 84, 22
    PUSHBUTTON "Move &right", IDC_COMBO_RIGHT, 360, 370, 84, 22
    DEFPUSHBUTTON "&Save", IDOK, 404, 402, 68, 22
    PUSHBUTTON "&Close", IDCANCEL, 480, 402, 68, 22
    LTEXT "&Preview", -1, 182, 408, 48, 12
    CONTROL "", IDC_COMBO_PREVIEW, "STATIC", SS_OWNERDRAW | WS_BORDER | WS_TABSTOP, 238, 400, 154, 26
    LTEXT "", IDC_COMBO_STATUS, 12, 431, 536, 14
END

IDD_COMBO_DETAILS DIALOGEX 0, 0, 340, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combination details - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", IDC_COMBO_NAME, 12, 10, 316, 20
    LTEXT "&Exact sequence", -1, 12, 34, 316, 12
    CONTROL "", IDC_COMBO_PREVIEW, "STATIC", SS_OWNERDRAW | WS_BORDER, 12, 50, 316, 44
    LTEXT "&Emoji in insertion order", -1, 12, 100, 316, 12
    LISTBOX IDC_COMBO_ENTRIES, 12, 116, 316, 68, LBS_NOINTEGRALHEIGHT | LBS_OWNERDRAWFIXED | LBS_HASSTRINGS | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Close", IDCANCEL, 252, 194, 76, 20
END

IDD_COMBO_DELETE DIALOGEX 0, 0, 340, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Delete combination"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Delete this combination, its favorites, learned history, and the aliases listed below?", -1, 12, 10, 316, 32
    LTEXT "&Affected aliases", -1, 12, 46, 316, 12
    EDITTEXT IDC_COMBO_PREVIEW, 12, 62, 316, 122, ES_READONLY | ES_MULTILINE | WS_VSCROLL
    PUSHBUTTON "&Delete", IDOK, 170, 194, 76, 20
    DEFPUSHBUTTON "&Cancel", IDCANCEL, 252, 194, 76, 20
END
