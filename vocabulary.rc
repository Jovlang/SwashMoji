#include <windows.h>
#include "vocabulary_ids.h"

IDD_VOCABULARY DIALOGEX 0, 0, 450, 382
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "My vocabulary - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Save your own phrases and keep up to ten favorites. Everything stays on this PC.", -1, 12, 10, 426, 16
    LTEXT "Saved &aliases", -1, 12, 34, 148, 12
    LISTBOX IDC_ALIASES, 12, 49, 148, 95, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&New", IDC_NEW_ALIAS, 12, 151, 68, 20
    PUSHBUTTON "&Delete", IDC_DELETE_ALIAS, 88, 151, 72, 20
    LTEXT "Pinned fa&vorites (1-10)", -1, 12, 184, 148, 12
    LISTBOX IDC_PINS, 12, 201, 148, 97, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Up", IDC_PIN_UP, 12, 305, 44, 20
    PUSHBUTTON "D&own", IDC_PIN_DOWN, 60, 305, 46, 20
    PUSHBUTTON "Unp&in", IDC_UNPIN, 110, 305, 50, 20
    LTEXT "&Phrase", -1, 174, 34, 264, 12
    EDITTEXT IDC_PHRASE, 174, 49, 264, 22, ES_AUTOHSCROLL
    LTEXT "Find an &emoji (English or Norwegian)", -1, 174, 80, 264, 12
    EDITTEXT IDC_TARGET_QUERY, 174, 95, 264, 22, ES_AUTOHSCROLL
    LTEXT "&Matching emoji (choose one)", -1, 174, 121, 264, 12
    LISTBOX IDC_TARGET_RESULTS, 174, 136, 264, 128, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT "Choose an emoji above.", IDC_TARGET_PREVIEW, 174, 272, 264, 26
    DEFPUSHBUTTON "&Save alias", IDC_SAVE_ALIAS, 174, 305, 80, 20
    PUSHBUTTON "Pin &favorite", IDC_PIN_TARGET, 262, 305, 90, 20
    PUSHBUTTON "&Close", IDCANCEL, 360, 305, 78, 20
    PUSHBUTTON "&New combination / edit...", IDC_COMBINATIONS, 12, 353, 160, 20
    LTEXT "", IDC_VOCABULARY_STATUS, 12, 334, 426, 16
END

IDD_COMBINATIONS DIALOGEX 0, 0, 510, 376
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combinations - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "&Saved combinations", -1, 12, 10, 140, 12
    LISTBOX IDC_COMBO_SAVED, 12, 26, 140, 282, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&New", IDC_COMBO_NEW, 12, 316, 65, 20
    PUSHBUTTON "&Delete", IDC_COMBO_DELETE, 83, 316, 69, 20
    LTEXT "Name / &trigger", -1, 166, 10, 332, 12
    EDITTEXT IDC_COMBO_NAME, 166, 26, 332, 20, ES_AUTOHSCROLL
    LTEXT "Find &emoji", -1, 166, 52, 332, 12
    EDITTEXT IDC_COMBO_QUERY, 166, 68, 332, 20, ES_AUTOHSCROLL
    LTEXT "Res&ults", -1, 166, 94, 332, 12
    LISTBOX IDC_COMBO_RESULTS, 166, 110, 332, 64, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    LTEXT "Var&iant", -1, 166, 181, 42, 12
    COMBOBOX IDC_COMBO_VARIANTS, 210, 178, 224, 110, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    PUSHBUTTON "&Add", IDC_COMBO_ADD, 440, 177, 58, 20
    LTEXT "Se&quence (2-8 emoji, in insertion order)", -1, 166, 203, 332, 12
    LISTBOX IDC_COMBO_ENTRIES, 166, 219, 332, 60, LBS_NOTIFY | LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    PUSHBUTTON "Re&move", IDC_COMBO_REMOVE, 166, 285, 68, 20
    PUSHBUTTON "Move &left", IDC_COMBO_LEFT, 240, 285, 78, 20
    PUSHBUTTON "Move &right", IDC_COMBO_RIGHT, 324, 285, 78, 20
    DEFPUSHBUTTON "Sa&ve", IDOK, 350, 316, 70, 20
    PUSHBUTTON "&Close", IDCANCEL, 428, 316, 70, 20
    LTEXT "&Preview", -1, 166, 321, 40, 12
    EDITTEXT IDC_COMBO_PREVIEW, 210, 313, 130, 25, ES_READONLY | ES_AUTOHSCROLL
    LTEXT "", IDC_COMBO_STATUS, 12, 347, 486, 22
END

IDD_COMBO_DETAILS DIALOGEX 0, 0, 340, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Combination details - SwashMoji"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "", IDC_COMBO_NAME, 12, 10, 316, 20
    LTEXT "&Exact sequence", -1, 12, 34, 316, 12
    EDITTEXT IDC_COMBO_PREVIEW, 12, 50, 316, 44, ES_READONLY | ES_MULTILINE | WS_VSCROLL
    LTEXT "&Emoji in insertion order", -1, 12, 100, 316, 12
    LISTBOX IDC_COMBO_ENTRIES, 12, 116, 316, 68, LBS_NOINTEGRALHEIGHT | WS_VSCROLL | WS_HSCROLL | WS_TABSTOP
    DEFPUSHBUTTON "&Close", IDCANCEL, 252, 194, 76, 20
END

IDD_COMBO_DELETE DIALOGEX 0, 0, 340, 224
STYLE DS_SETFONT | DS_MODALFRAME | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Delete combination"
FONT 10, "Segoe UI"
BEGIN
    LTEXT "Delete this combination, its favorites, learned history, and the aliases listed below?", -1, 12, 10, 316, 32
    LTEXT "&Affected aliases", -1, 12, 46, 316, 12
    EDITTEXT IDC_COMBO_PREVIEW, 12, 62, 316, 122, ES_READONLY | ES_MULTILINE | WS_VSCROLL
    PUSHBUTTON "&Delete", IDOK, 170, 194, 76, 20
    DEFPUSHBUTTON "&Cancel", IDCANCEL, 252, 194, 76, 20
END
